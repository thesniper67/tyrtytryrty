local Flight = {
    Speed = 350,
    Attachment = nil,
    Velocity = nil,
    Force = nil,
    DescentTime = 0,
    DescentLastY = nil,
    DescentLastClock = nil,
    DescentHRP = nil
}
local DESCENT_ACCEL_TIME = 1.2

local function SetCharNoclip(char, enabled)
    -- Preserve per-part baseline for the flying/hop recovery path.
    if not char then return end
    Flight.CollisionSaved = Flight.CollisionSaved or {}
    if enabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if Flight.CollisionSaved[part] == nil then
                    Flight.CollisionSaved[part] = (part.CanCollide == true)
                        or (Noclip.Saved ~= nil and Noclip.Saved[part] == true)
                end
                part.CanCollide = false
            end
        end
    else
        for part, original in pairs(Flight.CollisionSaved) do
            if part.Parent then part.CanCollide = original end
            Flight.CollisionSaved[part] = nil
        end
    end
end

function ClearFlightComponents()
    for _, key in ipairs({ "Velocity", "Force", "Attachment" }) do
        local obj = Flight[key]
        if obj then
            pcall(function() obj:Destroy() end)
            Flight[key] = nil
        end
    end
    Flight.DescentTime = 0
    Flight.DescentLastY = nil
    Flight.DescentLastClock = nil
    Flight.DescentHRP = nil
    if Flight.CollisionSaved then
        for part, original in pairs(Flight.CollisionSaved) do
            if part.Parent then pcall(function() part.CanCollide = original end) end
        end
        Flight.CollisionSaved = nil
    end
end

local function SetupFlightComponents(hrp)
    if Flight.Velocity and Flight.Velocity.Parent == hrp
        and Flight.Attachment and Flight.Attachment.Parent == hrp then
        return
    end

    ClearFlightComponents()

    local att = Instance.new("Attachment")
    att.Name = "AutoBounty_FlightAttachment"
    att.Parent = hrp
    Flight.Attachment = att

    local lv = Instance.new("LinearVelocity")
    lv.Name = "AutoBounty_FlightVelocity"
    lv.MaxForce = math.huge
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = Vector3.zero
    lv.Attachment0 = att
    lv.Parent = hrp
    Flight.Velocity = lv

    local totalMass = 0
    local char = hrp.Parent
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.Massless then
                totalMass = totalMass + part:GetMass()
            end
        end
    end

    local vf = Instance.new("VectorForce")
    vf.Name = "AutoBounty_AntiGravity"
    vf.ApplyAtCenterOfMass = true
    vf.Attachment0 = att
    vf.Force = Vector3.new(0, totalMass * Workspace.Gravity, 0)
    vf.Parent = hrp
    Flight.Force = vf
end

local function ResetDescentState()
    Flight.DescentTime = 0
    Flight.DescentLastY = nil
    Flight.DescentLastClock = nil
end

local function UpdateDescentState(hrp, descending)
    local now = os.clock()

    if not hrp then
        ResetDescentState()
        return 1
    end

    if Flight.DescentHRP ~= hrp then
        Flight.DescentHRP = hrp
        ResetDescentState()
        return 1
    end

    local lastY = Flight.DescentLastY
    local lastClock = Flight.DescentLastClock
    Flight.DescentLastY = hrp.Position.Y
    Flight.DescentLastClock = now

    if not lastY or not lastClock then return 1 end

    local dt = now - lastClock
    if dt <= 0 then return 1 end

    local dropRate = (lastY - hrp.Position.Y) / dt
    if descending and dropRate >= 5 then
        Flight.DescentTime = math.min(Flight.DescentTime + dt, DESCENT_ACCEL_TIME)
    else
        Flight.DescentTime = 0
    end

    local progress = Flight.DescentTime / DESCENT_ACCEL_TIME
    return 1 + (2.0 - 1) * (progress * progress)
end

local function FlyMoveTo(pos)
    if not pos then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    SetupFlightComponents(hrp)

    local dir = pos - hrp.Position
    if dir.Magnitude > 0.1 then
        local mult = UpdateDescentState(hrp, dir.Y < 0)
        if Flight.Velocity then
            Flight.Velocity.VectorVelocity = dir.Unit * Flight.Speed * mult
        end
    else
        if Flight.Velocity then
            Flight.Velocity.VectorVelocity = Vector3.zero
        end
        ResetDescentState()
    end
end

local function FlyStop()
    ResetDescentState()
    if Flight.Velocity then
        Flight.Velocity.VectorVelocity = Vector3.zero
    end
end

-- V5: recover ONLY if currently touching/entering a detected hazard.
-- Low, capped vertical speed avoids the fly-to-the-sky bug from an emergency launch.
task.spawn(function()
    while true do
        task.wait(0.15)
        local H = ChaseDiag.Hazard
        local enabled = Settings.AvoidHazards and Settings.HazardEmergencyLift
            and Settings.AutoBounty and not FleeActive and not HopActive()
        local root = enabled and GetHRP(LocalPlayer)
        local humanoid = enabled and GetHumanoid(LocalPlayer)
        local dangerous, reason, top = false, nil, nil
        if root and humanoid and humanoid.Health > 0 then
            dangerous, reason, top = H.IsDangerousHere(root, humanoid)
        end
        if dangerous and root then
            if not H.Recovery then
                UI.Log("HAZARD", "Emergency lift: " .. tostring(reason), "hazard_rescue", 3)
                StopTween()
                H.Recovery = true
            end
            SetupFlightComponents(root)
            local desiredY = (top or root.Position.Y) + math.clamp(tonumber(Settings.HazardClearance) or 18, 8, 45) + 3
            local need = math.max(4, desiredY - root.Position.Y)
            if Flight.Velocity then
                Flight.Velocity.VectorVelocity = Vector3.new(0, math.clamp(need * 3, 25, 80), 0)
            end
        elseif H.Recovery then
            FlyStop()
            ClearFlightComponents()
            H.Reset()
            UI.Log("HAZARD", "Emergency lift complete; normal chase restored", "hazard_rescue_end", 2)
        end
    end
end)

