    local function SetWidgetValue(widget, kind, value)
        local preferSelect = (kind == "dropdown" or kind == "multi")
        local order = preferSelect and { "Select", "Set" } or { "Set", "Select" }
        for _, name in ipairs(order) do
            local fn = widget[name]
            if type(fn) == "function" then
                if select(1, pcall(fn, widget, value)) then return true end
            end
        end
        return false
    end

    local function SyncUITo()
        for _, item in ipairs(SYNC_ITEMS) do
            local id, kind, getter = item[1], item[2], item[3]
            local widget = UI[id]
            if widget then
                local value = getter()
                if kind == "toggle" then
                    value = value == true
                elseif type(value) == "table" then
                    local list = {}
                    for key, on in pairs(value) do
                        if on then list[#list + 1] = key end
                    end
                    value = list
                end
                SetWidgetValue(widget, kind, value)
            end
        end
    end

    local LastSaveError = nil
    local LastSaveOk = false

    function SaveConfig(silent)
        if type(writefile) ~= "function" then
            LastSaveError = T("执行器不支持 writefile")
            LastSaveOk = false
            return false
        end
        EnsureConfigFolder()
        for _, key in ipairs({ "BountyBase", "AutoBountyBountyBase", "AutoBountyEarned", "AutoBountyRunTime" }) do
            Settings[key] = nil
        end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(Settings) end)
        if not ok then
            LastSaveError = T("序列化失败：") .. tostring(encoded)
            LastSaveOk = false
            return false
        end

        local ok2, err = pcall(writefile, CONFIG_FILE, encoded)
        if not ok2 then
            local ok3, err3 = pcall(writefile, CONFIG_FALLBACK_FILE, encoded)
            if ok3 then
                CONFIG_FILE = CONFIG_FALLBACK_FILE
                ok2, err = true, nil
            else
                err = tostring(err) .. T(" / 回退也失败：") .. tostring(err3)
            end
        end

        if ok2 then
            LastSaveError = nil
            LastSaveOk = true
        else
            LastSaveError = tostring(err)
            LastSaveOk = false
        end

        return ok2 == true
    end

    local function LoadConfig(silent)
        if type(isfile) ~= "function" or type(readfile) ~= "function" then
            return false
        end
        local source = CONFIG_FILE
        if not isfile(CONFIG_FILE) then
            if type(isfile) == "function" and isfile(CONFIG_FALLBACK_FILE) then
                source = CONFIG_FALLBACK_FILE
            elseif isfile(LEGACY_CONFIG_FILE) then
                source = LEGACY_CONFIG_FILE
            else
                return false
            end
        end
        local ok, raw = pcall(readfile, source)
        if not ok or type(raw) ~= "string" or raw == "" then
            return false
        end
        local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok2 or type(data) ~= "table" then
            return false
        end

        ApplyConfigTable(data)

        ApplyPlayerRange(Settings.HopPlayerRange)
        ApplyBountyRange(Settings.HopBountyRange)

        local loadedVersion = tonumber(data.ConfigVersion) or 1
        if loadedVersion < 2 then
            for _, holds in pairs(Settings.Hold) do
                for key in pairs(holds) do
                    holds[key] = DEFAULT_SKILL_HOLD
                end
            end
        end
        if loadedVersion < 9 then
            -- One-time migration from V7: establish the recommended defaults.
            -- Keep team, ESP, stored inventory and manual server preferences.
            local stable = {
                AutoCombo = true, ComboMode = "Stun First", ComboPick = "Best Match",
                ComboMaxSteps = 5, ComboDelay = 0.22,
                ComboUseSword = false, ComboUseGun = false,
                ComboAllowMobility = false, ComboStableMovement = true,
                ComboPreferCurated = true, ComboLearnResults = true,
                TargetPriority = "Nearest", IdleHopDelay = 15,
                ChaseUpdateSeconds = 0.065, ChaseMaxStep = 10,
                AimPrediction = true, AimLead = 0.10, AimPart = "Auto",
                FastAttack = false, FruitM1 = false, AutoSoru = false,
                AutoHaki = true, AutoKen = true, KenRetrySeconds = 2.5,
                AutoV3 = true, AutoV4 = true, AutoV4CombatOnly = true,
                SoruRapid = false, SoruInterval = 5, SoruMinDistance = 30,
                SoruMaxDistance = 280, SoruEnergyReserve = 15,
                AutoFlee = false, AutoEnablePVP = true,
                AvoidHazards = true, AvoidWater = true, AvoidLava = true,
                AvoidOtherDamage = true, HazardClearance = 18,
                HazardEmergencyLift = true,
                LockTime = 120, OutputVerbose = false,
                SkipUnproductiveTargets = true, NoProgressCombos = 4,
                NoProgressThreshold = 1.5, SkipTargetFor = 180,
                SkipExtremeMovement = true, SkipPersistentHover = true
            }
            for key, value in pairs(stable) do Settings[key] = value end
        end
        Settings.ConfigVersion = 9
        ConfigLoading = true
        SyncUITo()
        ConfigLoading = false
        if source ~= CONFIG_FILE or loadedVersion < 9 then
            SaveConfig(true)
        end
        return true
    end

