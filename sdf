local function KenStep()
    if not Settings.AutoKen then
        KenNextAt, KenFailCount, KenPendingAt = 0, 0, 0
        KenStatus = "off"
        return KenStatus
    end

    BindKenDisable()
    local char = KenChar()
    local now = os.clock()

    if not char then
        KenNextAt, KenFailCount, KenPendingAt = 0, 0, 0
        KenStatus = "no_char"
    elseif KenOn() then
        KenNextAt, KenFailCount, KenPendingAt = 0, 0, 0
        KenStatus = "on"
    elseif char:FindFirstChild("KenDisabled") then
        KenNextAt, KenFailCount, KenPendingAt = 0, 0, 0
        KenStatus = "blocked"
    elseif now < KenLockUntil then
        KenStatus = "locked"
    elseif now >= KenNextAt then
        if KenPendingAt > 0 and now - KenPendingAt >= KEN_VERIFY then
            KenFailCount = KenFailCount + 1
        end
        KenPendingAt = 0
        if KenFailCount >= KEN_MAX_FAILS then
            KenStatus = "fail"
            KenFailCount = 0
            KenNextAt = now + KEN_FAIL_BACKOFF
        else
            KenStatus = "trying"
            KenPressKey()
            KenPendingAt = os.clock()
            KenNextAt = os.clock() + math.clamp(tonumber(Settings.KenRetrySeconds) or 2.5, KEN_PRESS_GAP_MIN, 8)
        end
    else
        KenStatus = "wait"
    end
    return KenStatus
end

