local AutoSaveStatus = { Tabs = 0, Wrapped = 0, Buttons = 0, Failed = {} }

local WIDGET_METHODS = { "Toggle", "Slider", "Dropdown", "Button" }

local function WrapTabForAutoSave(tab)
    local wrapped = 0
    for _, name in ipairs(WIDGET_METHODS) do
        local original = tab[name]
        if type(original) == "function" then
            tab[name] = function(self, config, ...)
                if type(config) == "table" and type(config.Callback) == "function"
                    and config.AutoSave ~= false then
                    local userCallback = config.Callback
                    config.Callback = function(...)
                        local results = table.pack(pcall(userCallback, ...))
                        local ok, err = results[1], results[2]
                        if not ok then
                            LastCaughtError = T("控件回调异常：") .. tostring(err)
                        end
                        if not ConfigLoading and SaveConfig then
                            SaveConfig(true)
                        end
                        if not ok then error(err, 0) end
                        return table.unpack(results, 2, results.n)
                    end
                    if name == "Button" then
                        AutoSaveStatus.Buttons += 1
                    else
                        AutoSaveStatus.Wrapped += 1
                    end
                end
                return original(self, config, ...)
            end
            wrapped += 1
        end
    end
    return wrapped
end

for _, tab in pairs(Tabs) do
    local ok, err = pcall(WrapTabForAutoSave, tab)
    if ok then
        AutoSaveStatus.Tabs += 1
    else
        table.insert(AutoSaveStatus.Failed, tostring(err))
    end
end

