-- Event-driven, personal bounty change log (no external telemetry).
do
    task.spawn(function()
        local stats = LocalPlayer:WaitForChild("leaderstats", 30)
        local bounty = stats and stats:WaitForChild("Bounty/Honor", 30)
        if not bounty then
            UI.Log("WARN", "Bounty/Honor stat unavailable; bounty output tracking skipped")
            return
        end
        local last = tonumber(bounty.Value)
        bounty:GetPropertyChangedSignal("Value"):Connect(function()
            local now = tonumber(bounty.Value)
            if not now or not last then last = now return end
            local delta = now - last
            last = now
            if delta == 0 then return end
            if delta > 0 then
                UI.Diagnostics.Totals.bountyEarned += delta
                UI.Log("BOUNTY", "+" .. math.floor(delta) .. " (total gained this session: "
                    .. math.floor(UI.Diagnostics.Totals.bountyEarned) .. ")")
            else
                UI.Diagnostics.Totals.bountyLost -= delta
                UI.Log("BOUNTY", tostring(math.floor(delta)) .. " (total lost this session: "
                    .. math.floor(UI.Diagnostics.Totals.bountyLost) .. ")")
            end
        end)
    end)
end

