-- Bounded server discovery and a short-term blacklist of already visited instances.
-- Only make remote calls when a hop is actually requested.
local RecentHopServers = (function()
    local env = getgenv and getgenv()
    local history = type(env) == "table" and env.AutoBountyRecentServers or nil
    if type(history) ~= "table" then history = {} end
    local now = os.time()
    for job, stamp in pairs(history) do
        if type(job) ~= "string" or type(stamp) ~= "number"
            or stamp > now + 60 or now - stamp > 900 then history[job] = nil end
    end
    if game.JobId and game.JobId ~= "" then history[game.JobId] = now end
    if type(env) == "table" then env.AutoBountyRecentServers = history end
    return history
end)()

local ServerHopCache = { List = nil, Fetching = false, SavedAt = 0 }

local function FetchServerList(timeout)
    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not browser then
        UI.Log("WARN", "Server browser unavailable; will retry later", "browser_missing", 15)
        return nil
    end
    local servers, total = {}, 0
    local deadline = tick() + (timeout or 15)
    -- Up to 30 pages, no more than 5 concurrent InvokeServer calls at a time.
    for first = 1, 30, 5 do
        if tick() >= deadline then break end
        local pending = 0
        for page = first, math.min(first + 4, 30) do
            pending += 1
            task.spawn(function()
                local ok, result = pcall(function() return browser:InvokeServer(page) end)
                if ok and type(result) == "table" then
                    for job, info in pairs(result) do
                        if type(job) == "string" and type(info) == "table" and servers[job] == nil then
                            servers[job] = {
                                Region = tostring(info.Region or "Unknown"),
                                Count = tonumber(info.Count) or 0,
                                Bounty = tonumber(info.Bounty) or 0
                            }
                            total += 1
                        end
                    end
                end
                pending -= 1
            end)
        end
        while pending > 0 and tick() < deadline do task.wait(0.1) end
        -- Refresh enough choices without hammering every available page.
        if total >= 60 then break end
    end
    UI.Log("SERVER", "Server scan found " .. tostring(total) .. " instances", "server_scan", 10)
    return servers
end

local function GetServerList()
    local now = tick()
    if ServerHopCache.List and now - ServerHopCache.SavedAt < 30 then
        return ServerHopCache.List
    end
    if ServerHopCache.Fetching then
        local deadline = tick() + 18
        while ServerHopCache.Fetching and tick() < deadline do task.wait(0.1) end
        return ServerHopCache.List
    end
    ServerHopCache.Fetching = true
    local ok, servers = pcall(FetchServerList, 15)
    ServerHopCache.Fetching = false
    if ok and type(servers) == "table" and next(servers) then
        ServerHopCache.List = servers
        ServerHopCache.SavedAt = tick()
    else
        ServerHopCache.List = nil
    end
    return ServerHopCache.List
end

local function MatchRegion(info)
    if not info then return false end
    local want = tostring(Settings.ServerRegion or "")
    if want == "" or want == T("随机") or want == "Random" then return true end
    return tostring(info.Region or ""):lower():find(want:lower(), 1, true) ~= nil
end

local function MatchServer(info)
    if not info then return false end
    if not MatchRegion(info) then return false end
    local count = tonumber(info.Count) or 0
    if count < HopMinPlayers or count > HopMaxPlayers then return false end
    local bounty = tonumber(info.Bounty) or 0
    return bounty >= HopMinBounty and bounty <= HopMaxBounty
end

local function MatchServerRelaxed(info)
    if not MatchRegion(info) then return false end
    local count = tonumber(info.Count) or 0
    -- Relax bounty requirements, not player-count safety. Avoid empty/full instances.
    return count >= 1 and count <= HopMaxPlayers
end

local function CollectMatches(servers, predicate, skipRecent)
    local matches = {}
    if type(servers) ~= "table" then return matches end
    for job, info in pairs(servers) do
        local visited = RecentHopServers[job]
        if job ~= game.JobId and predicate(info)
            and (not skipRecent or not visited or os.time() - visited > 900) then
            matches[#matches + 1] = {
                Job = job, Region = info.Region, Count = info.Count,
                Bounty = info.Bounty
            }
        end
    end
    return matches
end

local function PickServer(servers)
    local matches = CollectMatches(servers, MatchServer, true)
    if #matches > 0 then
        return matches[math.random(1, #matches)], false
    end
    -- Preferred region and player count, but relaxed bounty threshold.
    local relaxed = CollectMatches(servers, MatchServerRelaxed, true)
    if #relaxed > 0 then
        return relaxed[math.random(1, #relaxed)], true
    end
    -- Last resort: reuse the oldest previously visited matching server.
    local previouslyVisited = CollectMatches(servers, MatchServer, false)
    if #previouslyVisited == 0 then
        previouslyVisited = CollectMatches(servers, MatchServerRelaxed, false)
    end
    if #previouslyVisited > 0 then
        table.sort(previouslyVisited, function(a, b)
            return (RecentHopServers[a.Job] or 0) < (RecentHopServers[b.Job] or 0)
        end)
        return previouslyVisited[1], true
    end
    return nil, false
end

