-- On each loadout, create up to 500 unique, non-repeating move orders.
-- Skill HUD is checked again at cast time (mastery/cooldowns/transformations).
local function MakeMovePool(owned)
    local pool = {}
    local keysSeen = {}
    local tips = { "Blox Fruit", "Melee" }
    if Settings.ComboUseSword then table.insert(tips, "Sword") end
    if Settings.ComboUseGun then table.insert(tips, "Gun") end
    for _, tip in ipairs(tips) do
        local tool = owned[tip]
        if tool then
            local profile = GetProfile(tool, tip)
            for _, group in ipairs({ "Open", "Extend", "Finish" }) do
                for _, key in ipairs(profile[group] or {}) do
                    local id = tip .. ":" .. key
                    local mobility = profile.Mobility and profile.Mobility[key]
                    if not keysSeen[id] and (not mobility or Settings.ComboAllowMobility) then
                        keysSeen[id] = true
                        table.insert(pool, { Tip = tip, Key = key, Role = group, ID = id,
                            Stun = profile.Stun and group == "Open" or false,
                            Mobility = mobility == true })
                    end
                end
            end
            if tip == "Blox Fruit" and Settings.ComboAllowMobility then
                table.insert(pool, { Tip = tip, Key = "F", Role = "Mobility", ID = tip .. ":F", Mobility = true })
            end
        end
    end
    return pool
end

local function MakeCatalog(pool, owned)
    local catalog, seen = {}, {}
    local requireMix = owned.Melee ~= nil and owned["Blox Fruit"] ~= nil
    local function push(seq, curated)
        local n, mixM, mixF, switches = #seq, false, false, 0
        if n < 2 then return end
        for i, item in ipairs(seq) do
            if item.Tip == "Melee" then mixM = true end
            if item.Tip == "Blox Fruit" then mixF = true end
            if i > 1 and seq[i-1].Tip ~= item.Tip then switches += 1 end
        end
        if (requireMix and not (mixM and mixF)) or switches > 3 then return end
        local ids = {}
        for _, item in ipairs(seq) do ids[#ids+1] = item.ID end
        local sig = table.concat(ids, "|")
        if seen[sig] then return end
        seen[sig] = true
        catalog[#catalog+1] = { Steps = table.clone(seq), Switches = switches, Signature = sig, Curated = curated == true }
    end
    -- Named curated sequences: move orders sourced from community combo guides;
    -- situational timing/aiming notes are NOT automatically guaranteed.
    local meleeName = StyleName(owned.Melee, "Melee")
    local fruitName = StyleName(owned["Blox Fruit"], "Blox Fruit")
    local curated = {
        ["lightning|dragon talon"] = {
            {"Blox Fruit:X", "Blox Fruit:Z", "Blox Fruit:C", "Melee:X", "Melee:C"},
        },
        ["lightning|godhuman"] = {
            {"Blox Fruit:V", "Blox Fruit:C", "Blox Fruit:X", "Melee:Z", "Melee:C", "Melee:X"},
        },
        ["lightning|sanguine art"] = {
            {"Blox Fruit:X", "Blox Fruit:C", "Melee:X", "Melee:Z"},
        },
        ["kitsune|dragon talon"] = {
            {"Blox Fruit:C", "Blox Fruit:X", "Blox Fruit:Z", "Melee:X", "Melee:C"},
        },
        ["magnet|dragon talon"] = {
            {"Blox Fruit:X", "Blox Fruit:Z", "Melee:Z", "Melee:X", "Melee:C"},
        }
    }
    for _, ids in ipairs(curated[fruitName .. "|" .. meleeName] or {}) do
        local sequence = {}
        for _, id in ipairs(ids) do
            for _, move in ipairs(pool) do
                if move.ID == id then sequence[#sequence+1] = move break end
            end
        end
        if #sequence == #ids then push(sequence, true) end
    end
    -- Quotas ensure short, medium and long options instead of 500 near-identical long combos.
    local quotas = { {5,160}, {4,110}, {6,100}, {3,70}, {7,60}, {8,40}, {2,25} }
    local function enumerate(length, quota)
        if length > #pool or #catalog >= 500 then return end
        local initial = #catalog
        local path, used = {}, {}
        local function walk(depth)
            if #catalog >= 500 or #catalog - initial >= quota then return end
            if depth > length then push(path) return end
            for i=1,#pool do
                -- Rotating traversal by depth gives distinct styles early in the library.
                local ix = (i + depth * 3 - 2) % #pool + 1
                local item = pool[ix]
                if not used[item.ID] then
                    if depth < 4 or path[depth-1].Tip ~= item.Tip
                        or depth < 3 or path[depth-2].Tip ~= item.Tip then
                        used[item.ID] = true
                        path[depth] = item
                        walk(depth+1)
                        path[depth] = nil
                        used[item.ID] = nil
                    end
                end
                if #catalog >= 500 or #catalog - initial >= quota then break end
            end
        end
        walk(1)
    end
    for _, spec in ipairs(quotas) do enumerate(spec[1], spec[2]) end
    if #catalog < 500 then
        for _, length in ipairs({5,6,4,7,3,8,2}) do
            enumerate(length, 500)
            if #catalog >= 500 then break end
        end
    end
    return catalog
end

local function ModeScore(variant, distance)
    local seq, switches = variant.Steps, variant.Switches
    local first, last, count = seq[1], seq[#seq], #seq
    local mode = Settings.ComboMode
    local ideal = (mode == "Quick") and 3 or ((mode == "Extended") and 7 or 5)
    local score = 18 - math.abs(count - ideal) * 4 - switches * 1.5
    if variant.Curated and Settings.ComboPreferCurated then score += 100 end
    if mode == "Stun First" then
        if first.Stun then score += 20 end
    elseif mode == "Burst" then
        if last.Role == "Finish" then score += 12 end
        score -= switches
    elseif mode == "Melee First" then
        if first.Tip == "Melee" then score += 20 end
    elseif mode == "Fruit First" then
        if first.Tip == "Blox Fruit" then score += 20 end
    elseif mode == "Quick" then
        score -= (count - 3) * 4
    elseif mode == "Extended" then
        score += count * 2
    else
        if first.Stun then score += 11 end
        if distance > 35 then
            if first.Tip == "Blox Fruit" then score += 10 end
        else
            if first.Tip == "Melee" then score += 5 end
        end
    end
    if first.Role == "Open" then score += 3 end
    if last.Role == "Finish" then score += 4 end
    for _, move in ipairs(seq) do
        if move.Mobility then score -= 18 end
    end
    return score
end

local function PickVariant(catalog, distance)
    local filtered = {}
    local maxSteps = math.clamp(tonumber(Settings.ComboMaxSteps) or 6, 2, 8)
    for i, v in ipairs(catalog) do
        if #v.Steps <= maxSteps then filtered[#filtered+1] = i end
    end
    if #filtered == 0 then return nil, 0 end
    local pick = Settings.ComboPick
    if pick == "Manual ID" then
        local n = math.clamp(math.floor(tonumber(Settings.ComboID) or 1), 1, #catalog)
        for _, i in ipairs(filtered) do
            if i >= n then return catalog[i], i end
        end
        local i = filtered[1]
        return catalog[i], i
    end
    if pick == "Cycle" then
        local i = filtered[(ComboState.Cursor - 1) % #filtered + 1]
        return catalog[i], i
    end
    if pick == "Random" then
        local i = filtered[math.random(1, #filtered)]
        return catalog[i], i
    end
    local best, bestID, high = nil, 0, -math.huge
    -- Experiment only among otherwise high-scoring candidates, never random
    -- mobility skills or unrelated weapons. Data is per loadout and session.
    local explore = Settings.ComboLearnResults and ComboState.Completed > 0
        and ComboState.Completed % math.clamp(tonumber(Settings.ComboLearningExploration) or 5, 3, 12) == 0
    local eligible = {}
    for _, i in ipairs(filtered) do
        local variant = catalog[i]
        local baseline = ModeScore(variant, distance)
        local record = ComboState.Performance[ComboState.Signature .. "|" .. variant.Signature]
        local score = baseline
        if Settings.ComboLearnResults and record and record.Count > 0 then
            local avg = record.Sum / record.Count
            -- Target HP reduction is a noisy proxy. Keep curated-order priority.
            score += math.clamp(avg * 0.30, 0, 24)
            if record.Sum <= 0 and record.Count >= 2 then score -= 5 end
        end
        if score > high then best, bestID, high = variant, i, score end
        if explore and baseline >= (Settings.ComboPreferCurated and 100 or 15) then
            if not record or record.Count == 0 then
                eligible[#eligible + 1] = i
            end
        end
    end
    if explore and #eligible > 0 then
        local ix = eligible[(math.floor(ComboState.Completed / 5) - 1) % #eligible + 1]
        return catalog[ix], ix
    end
    return best, bestID
end

ComboUpdate = function(force, distance)
    local now = tick()
    if not force and not ComboState.Dirty and now - ComboState.LastScan < 2 then return end
    ComboState.LastScan = now
    ComboState.Dirty = false
    local owned = Inventory()
    local signature = table.concat({
        owned.Melee and owned.Melee.Name or "-",
        owned["Blox Fruit"] and owned["Blox Fruit"].Name or "-",
        Settings.ComboUseSword and owned.Sword and owned.Sword.Name or "-",
        Settings.ComboUseGun and owned.Gun and owned.Gun.Name or "-",
        tostring(Settings.ComboAllowMobility)
    }, "|")
    if signature ~= ComboState.Signature then
        ComboState.Signature = signature
        ComboState.Catalog = MakeCatalog(MakeMovePool(owned), owned)
        ComboState.Cursor = 1
        UI.Log("INVENTORY", "Melee: " .. (owned.Melee and owned.Melee.Name or "none")
            .. "; Fruit: " .. (owned["Blox Fruit"] and owned["Blox Fruit"].Name or "none")
            .. "; candidates: " .. #ComboState.Catalog)
    end
    ComboState.Melee = owned.Melee
    ComboState.Fruit = owned["Blox Fruit"]
    ComboState.Sword = owned.Sword
    ComboState.Gun = owned.Gun
    ComboState.Count = #ComboState.Catalog
    local variant, index = PickVariant(ComboState.Catalog, distance or 50)
    ComboState.Plan = variant and variant.Steps or {}
    ComboState.Index = index
    ComboState.Curated = variant and variant.Curated or false
    local parts = {}
    for _, step in ipairs(ComboState.Plan) do
        local p = ({Melee="M", ["Blox Fruit"]="F", Sword="S", Gun="G"})[step.Tip] or "?"
        parts[#parts+1] = p .. step.Key
    end
    ComboState.Preview = table.concat(parts, " -> ")
end

local function SkillReady(tool, key)
    local ui = GetSkillUI()
    if not ui then return false end
    local holder = FindSkillHolder(ui, tool)
    local frame = holder and holder:FindFirstChild(key)
    if not frame or not frame:IsA("Frame") or not SkillFrameReady(frame) then return false end
    local title = frame:FindFirstChild("Title")
    local isTransform = title and type(title.Text) == "string"
        and string.find(string.lower(title.Text), "transform", 1, true)
    if isTransform then
        local id = tool.ToolTip .. key
        local last = TransformGuard.Last[id]
        if last and tick() - last < TransformGuard.Gap then return false end
    end
    return true, isTransform
end

local function IsTargetValid(target)
    if not Settings.AutoBounty or not target or CurrentTarget ~= target
        or UI.TargetGuard:IsSkipped(target)
        or FleeActive or HopActive() or ChaseDiag.Hazard.Recovery then return false end
    local me, them = GetHRP(LocalPlayer), GetHRP(target)
    local hum = GetHumanoid(target)
    local maxRange = ChaseDiag.ComboGuard.Active and 180 or 120
    return me ~= nil and them ~= nil and hum ~= nil and hum.Health > 0
        and (me.Position - them.Position).Magnitude <= maxRange
        and not IsPVPDisabled(target) and not IsInSafeZone(target)
end

AutoComboStep = function()
    local target = CurrentTarget
    if ComboState.Active or tick() < ComboState.NextAt or not IsTargetValid(target) then return end
    local observedHumanoid = GetHumanoid(target)
    local observedBefore = observedHumanoid and observedHumanoid.Health or 0
    local observedMax = observedHumanoid and observedHumanoid.MaxHealth or 1
    local me, them = GetHRP(LocalPlayer), GetHRP(target)
    ComboUpdate(false, (me.Position - them.Position).Magnitude)
    if #ComboState.Plan == 0 then
        ComboState.NextAt = tick() + 1
        return "no_loadout"
    end
    -- Pause chase/soru for the entire chain; keep normal skill animation physics.
    UI.Diagnostics.Totals.combos += 1
    UI.Log("COMBO", "Starting #" .. tostring(ComboState.Index)
        .. (ComboState.Curated and " [CURATED] " or " [generated] ") .. ComboState.Preview,
        "combo_begin", 0.5)
    ChaseDiag.ComboGuard.Active = true
    ChaseDiag.ComboGuard.Until = tick() + 0.5
    ComboState.Active = true
    StopTween()
    ClearFlightComponents()
    NoclipStop()
    local currentHumanoid = GetHumanoid(LocalPlayer)
    if currentHumanoid and currentHumanoid:GetState() == Enum.HumanoidStateType.Physics then
        pcall(function() currentHumanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
    end
    local ok, hitsOrError = pcall(function()
        local hits = 0 -- successfully sent skill inputs, not confirmed damage
        local previousTool = nil
        for _, step in ipairs(ComboState.Plan) do
            if not IsTargetValid(target) or not Settings.AutoCombo then
                UI.Diagnostics.Totals.interrupts += 1
                UI.Log("WARN", "Combo interrupted: target moved, disappeared or mode changed", "combo_interrupt", 1)
                break
            end
            local tool = (step.Tip == "Melee" and ComboState.Melee)
                or (step.Tip == "Blox Fruit" and ComboState.Fruit)
                or (step.Tip == "Sword" and ComboState.Sword)
                or (step.Tip == "Gun" and ComboState.Gun)
            if tool and tool.Parent and (tool.Parent == LocalPlayer.Character
                or tool.Parent == LocalPlayer:FindFirstChild("Backpack")) then
                if previousTool ~= tool then
                    LockWeapon("combo-swap", 0.55)
                    if not EquipTool(tool) then continue end
                    task.wait(0.1) -- wait for the HUD to swap
                    previousTool = tool
                end
                if not IsTargetValid(target) then break end
                local ready, transforming = SkillReady(tool, step.Key)
                if ready and CastSkill(step.Tip, step.Key, tool) then
                    hits += 1
                    UI.Diagnostics.Totals.casts += 1
                    if transforming then TransformGuard.Last[step.Tip .. step.Key] = tick() end
                    task.wait(math.clamp(tonumber(Settings.ComboDelay) or 0.19, 0.1, 0.8))
                else
                    UI.Diagnostics.Totals.skipped += 1
                    UI.Log("DEBUG", "Skipped " .. step.Tip .. " " .. step.Key .. " (cooldown/HUD/skill)",
                        "skip:" .. step.Tip .. step.Key, 3)
                end
            end
        end
        return hits
    end)
    ComboState.Active = false
    ChaseDiag.ComboGuard.Active = false
    ChaseDiag.ComboGuard.Until = tick() + (Settings.ComboStableMovement and 0.35 or 0)
    if not ok then
        ComboState.LastError = tostring(hitsOrError)
        UI.Log("ERROR", "Combo failed: " .. ComboState.LastError, "combo_error", 2)
        ComboState.NextAt = tick() + 1
        error(hitsOrError, 0)
    end
    -- Observe target HP after casts. This is not hit confirmation: team damage,
    -- health regen and other combatants can affect the reading.
    if hitsOrError > 0 then task.wait(0.12) end
    local observedAfter = (observedHumanoid and observedHumanoid.Parent
        and observedHumanoid == GetHumanoid(target)
        and observedHumanoid.Health) or observedBefore
    local observedDamage = math.max(0, observedBefore - observedAfter)
    ComboState.LastObservedDamage = observedDamage
    ComboState.Completed += 1
    -- Skipping after multiple input attempts is only a *heuristic*: no server
    -- damage attribution is available. Never call the player a hacker.
    local skipForNoProgress = UI.TargetGuard:OnCombo(target, hitsOrError, observedDamage, observedMax)
    if Settings.ComboLearnResults and hitsOrError > 0 and observedMax > 0 then
        ComboState.Dirty = true
        local variant = ComboState.Catalog[ComboState.Index]
        if variant then
            local key = ComboState.Signature .. "|" .. variant.Signature
            local record = ComboState.Performance[key] or { Count = 0, Sum = 0 }
            record.Count += 1
            record.Sum += (observedDamage / observedMax) * 100
            ComboState.Performance[key] = record
        end
    end
    UI.Log("COMBO", "Combo #" .. tostring(ComboState.Index) .. " finished: "
        .. tostring(hitsOrError) .. " cast input(s), target HP reduction ~"
        .. tostring(math.floor(observedDamage)) .. " (unverified attribution)", "combo_done", 0.4)
    ComboState.NextAt = tick() + (hitsOrError > 0 and 0.45 or 0.9)
    if skipForNoProgress and CurrentTarget == target then
        ResetTarget()
    end
    if Settings.ComboPick == "Cycle" then
        ComboState.Cursor += 1
        ComboState.Dirty = true
    elseif Settings.ComboPick == "Random" then
        ComboState.Dirty = true
    end
end

