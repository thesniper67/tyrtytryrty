local function GetNearestTarget()
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return nil, math.huge end
    local best, bestScore = nil, math.huge
    local now = tick()
    for _, plr in ipairs(Players:GetPlayers()) do
        if TempSkipUntil[plr] and now >= TempSkipUntil[plr] then
            TempSkipUntil[plr] = nil
        end
        if not TempSkipUntil[plr] and not LockGuard.IsLockedOut(plr) then
            local ok = select(1, EvaluateTarget(plr))
            if ok then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local dist = (hrp.Position - myHRP.Position).Magnitude
                local score = dist
                local hum = GetHumanoid(plr)
                local hpFraction = (hum and hum.MaxHealth > 0)
                    and math.clamp(hum.Health / hum.MaxHealth, 0, 1) or 1
                local priority = Settings.TargetPriority
                if priority == "Balanced" then
                    score = dist + hpFraction * 45
                elseif priority == "Lower Health" then
                    score = dist * 0.75 + hpFraction * 125
                end
                if score < bestScore then
                    best = plr
                    bestScore = score
                end
            end
        end
    end
    return best, bestScore
end

-- Aim positions use bounded velocity lead; no aim retargeting to unrelated players.
function Aim:Refresh(root)
    if not root or not root.Parent or not CurrentTarget then
        self.Part, self.Pos, self.Position = nil, nil, nil
        self.Smoothed = nil
        return
    end
    local character = CurrentTarget.Character
    if not character or not root:IsDescendantOf(character) then
        self.Part, self.Pos, self.Position, self.Smoothed = nil, nil, nil, nil
        return
    end
    local part = root
    if Settings.AimPart == "Head" then
        part = character:FindFirstChild("Head") or root
    elseif Settings.AimPart == "Upper Torso" then
        part = character:FindFirstChild("UpperTorso") or root
    elseif Settings.AimPart == "Auto" then
        part = character:FindFirstChild("UpperTorso") or root
    end
    local prediction = Vector3.zero
    if Settings.AimPrediction then
        local velocity = root.AssemblyLinearVelocity
        local lead = math.clamp(tonumber(Settings.AimLead) or 0.11, 0, 0.25)
        local flat = Vector3.new(velocity.X, 0, velocity.Z)
        if flat.Magnitude > 130 then flat = flat.Unit * 130 end
        prediction = flat * lead + Vector3.new(0,
            math.clamp(velocity.Y * lead, -(Settings.AimMaxVertical or 3), Settings.AimMaxVertical or 3), 0)
    end
    local desired = part.Position + prediction
    if self.LastTarget ~= CurrentTarget then
        self.Smoothed = desired
        self.LastTarget = CurrentTarget
    else
        self.Smoothed = self.Smoothed and self.Smoothed:Lerp(desired, 0.45) or desired
        -- Never let stale smoothing drift too far from the real target.
        if (self.Smoothed - desired).Magnitude > 20 then self.Smoothed = desired end
    end
    self.Part = part
    self.Position = self.Smoothed
    self.Pos = CFrame.new(self.Position)
end

