-- Buffered event output: low overhead, event-driven, no external telemetry.
UI.Diagnostics = { Entries = {}, Max = 140, Last = {}, Widget = nil,
    Totals = { casts = 0, skipped = 0, combos = 0, interrupts = 0,
        targets = 0, bountyEarned = 0, bountyLost = 0 } }
function UI.Log(level, message, key, cooldown)
    local diag = UI.Diagnostics
    local now = os.clock()
    local label = tostring(key or (level .. tostring(message)))
    if diag.Last[label] and now - diag.Last[label] < (cooldown or 0) then return end
    diag.Last[label] = now
    level = tostring(level or "INFO")
    local line = os.date("%H:%M:%S") .. " [" .. level .. "] " .. tostring(message)
    diag.Entries[#diag.Entries + 1] = line
    if #diag.Entries > diag.Max then table.remove(diag.Entries, 1) end
    if Settings.OutputToConsole and (level ~= "DEBUG" or Settings.OutputVerbose) then
        print("[AutoBounty V9] " .. line)
    end
end
function UI.Diagnostics:Text(lastN)
    local lines = {}
    for i = math.max(1, #self.Entries - (lastN or 10) + 1), #self.Entries do
        lines[#lines+1] = self.Entries[i]
    end
    return table.concat(lines, "\n")
end
