-- ComboGuard shares the existing ChaseDiag local to stay under the
-- Luau 200-local-register limit at script-chunk scope.
local ChaseDiag = {
    ComboGuard = { Active = false, Until = 0 },
    Steps = 0,
    Moves = 0,
    Direct = 0,
    Mode = "tween",
    LastPos = nil,
    LastPosTime = 0,
    LastStepTime = 0,
    StuckCount = 0,
    NextChaseUpdate = 0,
    LastTargetEnd = tick(),
    LastTargetEndReason = "initial",
    LastMoveAt = 0,
    LastChaseError = nil
}

-- V5 hazard avoidance shares ChaseDiag to avoid Luau chunk local-register overflow.
-- Server-side damage logic can change; detection is best effort, not invulnerability.
ChaseDiag.Hazard = {
    Recovery = false,
    Until = 0,
    CacheAt = -100,
    CacheFrom = nil,
    CacheTo = nil,
    CacheSafe = nil,
    LastReason = nil,
}
do
    local H = ChaseDiag.Hazard
    RJR.Hazard = H -- Movement helpers defined earlier use the same guard.
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = false
    params.RespectCanCollide = false

    local function refreshIgnore()
        params.FilterDescendantsInstances = LocalPlayer.Character and { LocalPlayer.Character } or {}
    end

    local function dangerKind(hit)
        if not hit then return nil end
        if hit.Material == Enum.Material.Water then
            return Settings.AvoidWater and "water" or nil
        end
        local part = hit.Instance
        if not part or not part:IsA("BasePart") then return nil end
        local name = string.lower(part.Name)
        if Settings.AvoidWater and (name == "sea" or name == "ocean" or name == "water"
                or string.find(name, "waterzone", 1, true)) then
            return "water"
        end
        if Settings.AvoidLava and (string.find(name, "lava", 1, true)
                or string.find(name, "magma", 1, true)
                or string.find(name, "volcanichazard", 1, true)) then
            return "lava/magma"
        end
        if Settings.AvoidOtherDamage and (string.find(name, "acid", 1, true)
                or string.find(name, "poison", 1, true)
                or string.find(name, "killbrick", 1, true)
                or string.find(name, "killpart", 1, true)
                or string.find(name, "damagezone", 1, true)
                or string.find(name, "damagepart", 1, true)) then
            return "damage zone"
        end
        return nil
    end

    -- The ray starts well above the requested point, so water at y ~= 0 is handled.
    -- World-specific invisible damage zones that cannot be raycast are not detectable.
    function H.SurfaceAt(position)
        if not Settings.AvoidHazards then return nil, nil end
        refreshIgnore()
        local height = math.max(65, math.min(135, (tonumber(Settings.HazardScanDepth) or 135) * 0.65))
        local depth = math.clamp(tonumber(Settings.HazardScanDepth) or 135, 70, 300)
        local hit = Workspace:Raycast(position + Vector3.new(0, height, 0),
            Vector3.new(0, -(depth + height), 0), params)
        local kind = dangerKind(hit)
        -- Ignore elevated damage decorations/ceilings that are well above our route.
        -- Swimming recovery is handled separately by IsDangerousHere().
        if kind and hit.Position.Y <= position.Y + 25 then
            return kind, hit.Position.Y
        end
        return nil, nil
    end

    -- Calculate an elevated waypoint only where a hazard is actually in the way.
    -- This avoids snap-to-sky when the target is on ordinary land.
    function H.Resolve(fromPos, destPos)
        if not Settings.AvoidHazards then return destPos end
        local now = tick()
        if H.CacheTo and H.CacheFrom and now - H.CacheAt < 0.14
            and (H.CacheTo - destPos).Magnitude < 7
            and (H.CacheFrom - fromPos).Magnitude < 8 then
            return H.CacheSafe or destPos
        end
        local clearance = math.clamp(tonumber(Settings.HazardClearance) or 18, 8, 45)
        local surfaceTop, reason = nil, nil
        for _, fraction in ipairs({0.20, 0.45, 0.70, 1}) do
            local sample = fromPos:Lerp(destPos, fraction)
            local kind, top = H.SurfaceAt(sample)
            if kind and (not surfaceTop or top > surfaceTop) then
                surfaceTop, reason = top, kind
            end
        end
        -- Catch directly intersected named damage parts along the horizontal path.
        refreshIgnore()
        local travel = destPos - fromPos
        if travel.Magnitude > 0.1 then
            local hit = Workspace:Raycast(fromPos, travel, params)
            local kind = dangerKind(hit)
            if kind and (not surfaceTop or hit.Position.Y > surfaceTop) then
                surfaceTop, reason = hit.Position.Y, kind
            end
        end
        local safe = destPos
        if surfaceTop and (fromPos.Y < surfaceTop + clearance
                or destPos.Y < surfaceTop + clearance) then
            local minimum = surfaceTop + clearance
            local planar = Vector3.new(destPos.X - fromPos.X, 0, destPos.Z - fromPos.Z).Magnitude
            if planar > 12 and fromPos.Y < minimum - 2 then
                -- Ascend above the danger before crossing it; don't tween diagonally through it.
                safe = Vector3.new(fromPos.X, minimum, fromPos.Z)
            else
                safe = Vector3.new(destPos.X, math.max(destPos.Y, minimum), destPos.Z)
            end
            UI.Log("HAZARD", "Avoiding " .. tostring(reason) .. " (clearance "
                .. tostring(math.floor(clearance)) .. " studs)", "hazard:" .. tostring(reason), 6)
        end
        H.CacheAt, H.CacheFrom, H.CacheTo, H.CacheSafe = now, fromPos, destPos, safe
        return safe
    end

    function H.IsDangerousHere(root, humanoid)
        if not Settings.AvoidHazards or not root then return false, nil, nil end
        local kind, top = H.SurfaceAt(root.Position)
        if humanoid and Settings.AvoidWater
            and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
            return true, "water", top or root.Position.Y
        end
        local gap = math.clamp(tonumber(Settings.HazardClearance) or 18, 8, 45)
        if kind and top and top <= root.Position.Y + 12
            and root.Position.Y < top + math.min(gap, 12) then
            return true, kind, top
        end
        return false, nil, nil
    end

    function H.SafeForSoru(position)
        if not Settings.AvoidHazards then return true end
        local kind, top = H.SurfaceAt(position)
        local gap = math.clamp(tonumber(Settings.HazardClearance) or 18, 8, 45)
        return not kind or not top or position.Y >= top + gap
    end

    function H.Reset()
        H.Recovery = false
        H.Until = 0
        H.CacheAt = -100
        H.CacheFrom, H.CacheTo, H.CacheSafe = nil, nil, nil
    end
end

local function DirectStepMove(targetPos, now)
    local hrp = GetHRP(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not hrp or not hum then return false end
    local dt = now - (ChaseDiag.LastStepTime > 0 and ChaseDiag.LastStepTime or now)
    ChaseDiag.LastStepTime = now
    dt = math.clamp(dt, 0.001, 0.1)
    targetPos = ChaseDiag.Hazard.Resolve(hrp.Position, targetPos)
    local delta = targetPos - hrp.Position
    if delta.Magnitude < 0.01 then return false end
    local step = math.min(RJR.TweenSpeed * dt, delta.Magnitude)
    SetNoCollide()
    NoclipStart()
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function()
        hrp.CFrame = CFrame.new(hrp.Position + delta.Unit * step) * (hrp.CFrame - hrp.CFrame.Position)
    end)
    ChaseDiag.Direct = ChaseDiag.Direct + 1
    return true
end

local function ChaseStep()
    -- Movement arbitration: RenderStepped updates aim, but chase pathfinding/teleports
    -- should not run at graphics-frame rate. Keep combat/hazard gates above this guard.
    ChaseDiag.Steps = ChaseDiag.Steps + 1
    local myHRP = GetHRP(LocalPlayer)
    local myHum = GetHumanoid(LocalPlayer)
    if not myHRP or not myHum or myHum.Health <= 0 then
        StopTween()
        NoclipStop()
        return
    end

    local targetRoot = CurrentTarget
        and CurrentTarget.Character
        and CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        targetRoot = CurrentTargetRoot
    end
    if not targetRoot or not targetRoot.Parent then
        StopTween()
        NoclipStop()
        ChaseSample = nil
        return
    end
    CurrentTargetRoot = targetRoot
    if UI.TargetGuard:Movement(CurrentTarget, targetRoot) then
        -- Main target-maintenance loop owns the actual reset to avoid racing it.
        StopTween()
        NoclipStop()
        return
    end
    Aim:Refresh(targetRoot)

    if FleeActive or HopActive() then
        StopTween()
        NoclipStop()
        return
    end
    if ChaseDiag.Hazard.Recovery then
        StopTween()
        NoclipStop()
        return
    end
    -- Do not snap/tween the player into the sky while a combo animation casts.
    if Settings.AutoCombo and Settings.ComboStableMovement
        and (ChaseDiag.ComboGuard.Active or tick() < ChaseDiag.ComboGuard.Until) then
        StopTween()
        ClearFlightComponents()
        NoclipStop()
        if myHum:GetState() == Enum.HumanoidStateType.Physics then
            pcall(function() myHum:ChangeState(Enum.HumanoidStateType.Freefall) end)
        end
        return
    end

    local nowMove = tick()
    if nowMove < ChaseDiag.NextChaseUpdate then return end
    ChaseDiag.NextChaseUpdate = nowMove + math.clamp(tonumber(Settings.ChaseUpdateSeconds) or 0.065, 0.04, 0.18)

    local targetPos = targetRoot.Position
    local dist = (myHRP.Position - targetPos).Magnitude
    local vel = Vector3.zero
    local now = tick()
    if ChaseSample then
        local dt = now - ChaseSample.t
        if dt > 0 and dt < 1 and (targetPos - ChaseSample.pos).Magnitude <= RJR.MaxSampleJump then
            vel = (targetPos - ChaseSample.pos) / dt
        end
    end
    if not ChaseSample or now - ChaseSample.t >= RJR.SampleInterval then
        ChaseSample = { pos = targetPos, t = now }
    end

    local off = RandomOffset()
    if dist <= RJR.SnapDist then
        StopTween()
        ClearFlightComponents()
        ChaseDiag.Mode = "tween"
        ChaseDiag.StuckCount = 0
        ChaseDiag.LastPos = nil
        myHRP.AssemblyLinearVelocity = Vector3.zero
        NoclipStart()
        if now - ChaseLastSnap >= RJR.SnapInterval then
            ChaseLastSnap = now
            pcall(function()
                local horizontal = Vector3.new(vel.X, 0, vel.Z) * RJR.PredictLead
                if horizontal.Magnitude > 14 then horizontal = horizontal.Unit * 14 end
                local destination = targetPos + horizontal + off
                -- Don't teleport upwards by a large amount in one frame.
                local safeY = myHRP.Position.Y + math.clamp(destination.Y - myHRP.Position.Y, -4, 4)
                local planned = ChaseDiag.Hazard.Resolve(myHRP.Position,
                    Vector3.new(destination.X, safeY, destination.Z))
                local displacement = planned - myHRP.Position
                -- Bound EVERY close-range snap. This stops long accidental jumps
                -- when the target teleports, moves vertically, or replication lags.
                local maxStep = math.clamp(tonumber(Settings.ChaseMaxStep) or 10, 3, 18)
                if displacement.Magnitude > maxStep then
                    planned = myHRP.Position + displacement.Unit * maxStep
                end
                if ChaseDiag.Hazard.SafeForSoru(planned) then
                    myHRP.CFrame = CFrame.new(planned) * (myHRP.CFrame - myHRP.CFrame.Position)
                end
            end)
        end
        return
    end

    if not ChaseDiag.LastPos or (now - ChaseDiag.LastPosTime) >= 1.5 then
        if ChaseDiag.LastPos
            and (myHRP.Position - ChaseDiag.LastPos).Magnitude < 5
            and dist > RJR.SnapDist then
            ChaseDiag.StuckCount = ChaseDiag.StuckCount + 1
            if ChaseDiag.Mode ~= "direct" then
                ChaseDiag.Mode = "direct"
                UI.Log("WARN", "Chase tween stalled; using direct movement", "chase_stall", 20)
                StopTween()
                ClearFlightComponents()
            end
        end
        ChaseDiag.LastPos = myHRP.Position
        ChaseDiag.LastPosTime = now
    end

    if ChaseDiag.Mode == "direct" then
        DirectStepMove(targetPos + off, now)
    else
        MoveTo(targetRoot.CFrame + off, RJR.TweenSpeed)
        ChaseDiag.Moves = ChaseDiag.Moves + 1
    end
end

