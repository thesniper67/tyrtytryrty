        return nil
    end

    local function SoruTo(targetPosition)
        local hrp = GetHRP(LocalPlayer)
        local hum = GetHumanoid(LocalPlayer)
        if not hrp or not hum or hum.Health <= 0 then return false end
        local startCFrame = hrp.CFrame
        local finalCFrame = (startCFrame - startCFrame.Position) + targetPosition
            + Vector3.new(0, hrp.Size.Y * 1.5, 0)
        return pcall(function()
            CommE:FireServer("Soru", startCFrame, finalCFrame,
                Workspace:GetServerTimeNow(), math.random(1, 999999999))
        end)
    end

    local function TrySoru()
        if not Settings.AutoBounty or FleeActive or HopActive() then return "idle" end
        if Settings.AutoCombo and Settings.ComboStableMovement
            and (ChaseDiag.ComboGuard.Active or tick() < ChaseDiag.ComboGuard.Until) then return "combo" end
        if ChaseDiag.Hazard.Recovery then return "hazard" end
        local interval = Settings.SoruRapid
            and math.clamp(tonumber(Settings.SoruInterval) or 5, 2.5, 15) or 10
        if tick() - SoruLastTime < interval then return "cooldown" end
        local targetRoot = CurrentTarget and GetHRP(CurrentTarget) or nil
        local targetHum = CurrentTarget and GetHumanoid(CurrentTarget) or nil
        local myRoot = GetHRP(LocalPlayer)
        if not targetRoot or not targetHum or targetHum.Health <= 0 or not myRoot then return "no_target" end
        local distance = (targetRoot.Position - myRoot.Position).Magnitude
        local minDistance = math.clamp(tonumber(Settings.SoruMinDistance) or 30, 5, 120)
        local maxDistance = math.clamp(tonumber(Settings.SoruMaxDistance) or 280, 80, 900)
        if distance < minDistance or distance > maxDistance then return "out_of_range" end
        if math.abs(targetRoot.Position.Y - myRoot.Position.Y) > 25 then return "vertical" end
        local energyPercent = ReadEnergyPercent()
        if energyPercent and energyPercent < (tonumber(Settings.SoruEnergyReserve) or 15) then
            return "low_energy"
        end
        local dest = (targetRoot.CFrame * CFrame.new(0, 0, 4)).Position
        if not ChaseDiag.Hazard.SafeForSoru(dest) then return "unsafe" end
        if SoruTo(dest) then
            SoruLastTime = tick()
            UI.Log("ABILITY", "Soru attempted toward locked target (server cooldown applies)", "soru_attempt", 6)
            return "attempt"
        end
        SoruLastTime = tick() -- back off even after a failed send
        UI.Log("WARN", "Soru remote request failed", "soru_fail", 15)
        return "failed"
    end

    task.spawn(function()
        while true do
            task.wait(0.5)
            if Settings.AutoSoru then
                local ok, reason = pcall(TrySoru)
                if ok and reason ~= lastSoruReason then
                    if reason == "unsafe" or reason == "vertical" then
                        UI.Log("ABILITY", "Soru held: " .. reason .. " landing", "soru_"..reason, 10)
                    elseif reason == "low_energy" then
                        UI.Log("ABILITY", "Soru held: low readable energy", "soru_energy", 10)
                    end
                    lastSoruReason = reason
                end
            else
                lastSoruReason = nil
            end
        end
    end)
end

do
    local FLEE_ASCEND = 1500
    local FLEE_PLAYER_RANGE = 1500

    local FleeReturnPos = nil
    local FleeStartY = nil

    local function PlayersWithinRange(range)
        local myHRP = GetHRP(LocalPlayer)
        if not myHRP then return 0 end
        local myPos = myHRP.Position
        local count = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local hum = GetHumanoid(plr)
                local hrp = GetHRP(plr)
                if hum and hrp and hum.Health > 0
                    and (hrp.Position - myPos).Magnitude <= range then
                    count = count + 1
                end
            end
        end
        return count
    end

    local function ClearFleeState()
        FleeActive = false
        FleeReturnPos = nil
        FleeStartY = nil
    end

    local function StopFleeFly()
        FlyStop()
        ClearFlightComponents()
        local char = LocalPlayer.Character
        if char then SetCharNoclip(char, false) end
    end

    task.spawn(function()
        while true do
            task.wait(0.1)
            if not Settings.AutoFlee or not Settings.AutoBounty then
                if FleeActive then StopFleeFly() end
                ClearFleeState()
                continue
            end
            local hum = GetHumanoid(LocalPlayer)
            local hrp = GetHRP(LocalPlayer)
            if not hum or hum.Health <= 0 then
                if FleeActive then StopFleeFly() end
                ClearFleeState()
                continue
            end
            if not hrp then continue end

            local hpPercent = (hum.Health / hum.MaxHealth) * 100
            if hpPercent <= Settings.AutoFleeHP then
                if not FleeActive then
                    UI.Log("WARN", "Auto Flee: health low; intentionally ascending. Disable Auto Flee to stop this.", "auto_flee", 10)
                    FleeActive = true
                    FleeReturnPos = hrp.CFrame
                    FleeStartY = hrp.Position.Y
                    StopTween()
                end
                local climbed = hrp.Position.Y - (FleeStartY or hrp.Position.Y)
                if climbed < FLEE_ASCEND or PlayersWithinRange(FLEE_PLAYER_RANGE) > 0 then
                    SafeCall(FleeUpLogic)
                else
                    FlyStop()
                end
            elseif FleeActive then
                StopFleeFly()
                local returnPos = FleeReturnPos
                ClearFleeState()
                if returnPos then
                    MoveTo(returnPos, RJR.TweenSpeed)
                end
            end
        end
    end)
end

