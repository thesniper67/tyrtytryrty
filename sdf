local function BuildReExecuteScript()
    GetEarnedBounty()
    local env = getgenv and getgenv()
    local lang = type(env) == "table" and (env.Language or env.language) or nil
    local parts = { "getgenv().AutoBountyMainLoaded = nil" }
    if type(lang) == "string" and lang ~= "" then
        parts[#parts + 1] = string.format("getgenv().Language = %q", lang)
    end
    parts[#parts + 1] = string.format("getgenv().AutoBountyRunTime = %.0f", GetRunTime())
    parts[#parts + 1] = string.format("getgenv().AutoBountyEarned = %.0f", LastEarned)
    -- Carry recent destinations across the teleport, not just during this script run.
    local recent = type(env) == "table" and env.AutoBountyRecentServers or nil
    if type(recent) == "table" then
        local encoded, n = {}, 0
        for job, stamp in pairs(recent) do
            if type(job) == "string" and #job < 150 and type(stamp) == "number"
                and os.time() - stamp < 900 and n < 24 then
                encoded[#encoded + 1] = string.format("[%q]=%d", job, math.floor(stamp))
                n += 1
            end
        end
        parts[#parts + 1] = "getgenv().AutoBountyRecentServers = {" .. table.concat(encoded, ",") .. "}"
    end
    -- Auto-reload only the matching version. Never fall back to unrelated remote code.
    parts[#parts + 1] = 'local ok, src = pcall(function() return readfile("AutoBounty_SmartCombo_V9_Audited.lua") end)'
    parts[#parts + 1] = 'if ok and type(src) == "string" and #src > 0 then loadstring(src)() else warn("[AutoBounty V9] Local V9 file unavailable; re-execute the V9 loader manually") end'
    return table.concat(parts, "\n") .. "\n"
end

local function QueueAutoReExecute()
    local source = BuildReExecuteScript()
    if type(queue_on_teleport) == "function" then
        return select(1, pcall(queue_on_teleport, source))
    end
    if type(queueonteleport) == "function" then
        return select(1, pcall(queueonteleport, source))
    end
    if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
        return select(1, pcall(syn.queue_on_teleport, source))
    end
    return false
end

