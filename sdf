-- Session-only target filtering. No proof-of-exploit claims: skips simply avoid
-- targets who show too little observed progress or are repeatedly unreachable.
UI.TargetGuard = { Records = {}, Skips = {}, Skipped = 0 }
function UI.TargetGuard:Key(plr)
    return tostring(plr and plr.UserId or "unknown")
end
function UI.TargetGuard:IsSkipped(plr)
    if not Settings.SkipUnproductiveTargets or not plr then return false end
    local key = self:Key(plr)
    local info = self.Skips[key]
    if not info then return false end
    if tick() < info.Expiry then return true end
    self.Skips[key] = nil
    return false
end
function UI.TargetGuard:Mark(plr, reason)
    if not Settings.SkipUnproductiveTargets or not plr then return false end
    self.Skips[self:Key(plr)] = {
        Expiry = tick() + math.clamp(tonumber(Settings.SkipTargetFor) or 180, 30, 900),
        Reason = tostring(reason)
    }
    self.Records[self:Key(plr)] = nil
    self.Skipped += 1
    UI.Log("TARGET", "Temporarily skipped " .. plr.Name .. " (" .. tostring(reason)
        .. "); not proof of cheating", "skip_target:" .. self:Key(plr), 4)
    return true
end
function UI.TargetGuard:OnLock(plr)
    self.Records[self:Key(plr)] = { NoProgress = 0, Position = nil,
        At = 0, Abnormal = 0, LastMovement = 0, Casts = 0,
        LastHoverCheck = 0, HoverSince = 0 }
end
function UI.TargetGuard:Movement(plr, root)
    if not Settings.SkipUnproductiveTargets or not plr or not root then return false end
    local record = self.Records[self:Key(plr)]
    if not record then return false end
    local now = tick()
    if record.Position then
        local dt = now - record.At
        if Settings.SkipExtremeMovement and dt > 0.03 and dt <= 0.35
            and (root.Position - record.Position).Magnitude >=
                math.clamp(tonumber(Settings.ExtremeMoveDistance) or 230, 150, 500) then
            if now - record.LastMovement > 12 then record.Abnormal = 0 end
            record.Abnormal += 1
            record.LastMovement = now
            if record.Abnormal >= 3 then
                return self:Mark(plr, "repeated unreachable movement")
            end
        end
    end
    record.Position, record.At = root.Position, now
    if Settings.SkipPersistentHover and now - record.LastHoverCheck >= 1 then
        record.LastHoverCheck = now
        local hovering = false
        if root.Position.Y > 80 and math.abs(root.AssemblyLinearVelocity.Y) < 5 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.IgnoreWater = false
            local ignore = {}
            if plr.Character then ignore[#ignore + 1] = plr.Character end
            if LocalPlayer.Character then ignore[#ignore + 1] = LocalPlayer.Character end
            rayParams.FilterDescendantsInstances = ignore
            local hit = Workspace:Raycast(root.Position,
                Vector3.new(0, -140, 0), rayParams)
            hovering = hit == nil
        end
        if hovering then
            if record.HoverSince == 0 then record.HoverSince = now end
            if now - record.HoverSince >= 12 then
                return self:Mark(plr, "persistent hovering above empty space")
            end
        else
            record.HoverSince = 0
        end
    end
    return false
end
function UI.TargetGuard:OnCombo(plr, castInputs, observedDamage, maxHP)
    if not Settings.SkipUnproductiveTargets or not plr or (castInputs or 0) < 2
        or (maxHP or 0) <= 0 then return false end
    local record = self.Records[self:Key(plr)]
    if not record then return false end
    local hp = GetHumanoid(plr)
    if not hp or hp.Health <= 0 or hp.Health < hp.MaxHealth * 0.05 then return false end
    record.Casts += castInputs
    local percent = 100 * math.max(0, observedDamage or 0) / maxHP
    if percent >= math.clamp(tonumber(Settings.NoProgressThreshold) or 1.5, 0.3, 10) then
        record.NoProgress = 0
    else
        record.NoProgress += 1
    end
    if record.NoProgress >= math.clamp(tonumber(Settings.NoProgressCombos) or 4, 2, 10) then
        return self:Mark(plr, "no measurable HP progress after "
            .. tostring(record.NoProgress) .. " combos")
    end
    return false
end

