-- Active combat takes priority over the ordinary lock timeout and server stay limit.
-- Method on an existing table to avoid adding script-scope locals (Luau has a 200-register limit).
function Stay:IsEngaged()
    if not Settings.AutoBounty or not CurrentTarget or FleeActive then return false end
    local myRoot, targetRoot = GetHRP(LocalPlayer), GetHRP(CurrentTarget)
    local targetHum = GetHumanoid(CurrentTarget)
    if not myRoot or not targetRoot or not targetHum or targetHum.Health <= 0 then return false end
    if IsPVPDisabled(CurrentTarget) or IsInSafeZone(CurrentTarget) then return false end
    return (myRoot.Position - targetRoot.Position).Magnitude <= 150
end

local function EvaluateTarget(plr)
    if not plr or plr == LocalPlayer then return false, "self" end
    local char = plr.Character
    if not char then return false, "no_character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "missing_parts" end
    if hum.Health <= 0 then return false, "dead" end
    if hrp.Position.Y < -100 then return false, "too_low" end
    if IsInSafeZone(plr) then return false, "safe_zone" end
    if IsPVPDisabled(plr) then return false, "pvp_disabled" end
    local myTeam = LocalPlayer.Team
    local tgTeam = plr.Team
    if myTeam and tgTeam and myTeam.Name == "Marines" and tgTeam.Name == "Marines" then
        return false, "same_team"
    end
    local myLv = GetLevel(LocalPlayer)
    local tgLv = GetLevel(plr)
    if myLv and tgLv and math.abs(myLv - tgLv) > 700 then return false, "level_gap" end
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return false, "no_local_hrp" end
    if (hrp.Position - myHRP.Position).Magnitude > 30000 then return false, "too_far" end
    if IsInSoloPvp(plr) then return false, "solo_pvp" end
    return true, nil
end

