local function BeginHopMatch()
    HopPhase = "matching"
    UI.HopState.Generation += 1
    local generation = UI.HopState.Generation
    task.spawn(function()
        local servers = GetServerList()
        local target = PickServer(servers)
        if not target then
            ServerHopCache.List = nil
            servers = GetServerList()
            target = PickServer(servers)
        end

        if generation ~= UI.HopState.Generation or HopPhase ~= "matching" then return end

        if not target then
            task.wait(3)
            if generation ~= UI.HopState.Generation or HopPhase ~= "matching" then return end
            HopPhase = "idle"
            HopCooldownUntil = tick() + 20
            UI.Log("WARN", "No matching servers; retrying after 20 seconds", "hop_none", 12)
            return
        end

        if IsBountyAtRisk() then
            HopPhase = "preparing"
            HopInterruptedByDanger = true
            StartHopAscend()
            return
        end

        local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if browser then
            if generation ~= UI.HopState.Generation or HopPhase ~= "matching"
                or IsBountyAtRisk() or (CurrentTarget and not Stay.Armed) then
                if generation == UI.HopState.Generation and HopPhase == "matching" then
                    HopPhase = "idle"
                end
                return
            end
            -- Record before queuing, so destination history survives teleport.
            -- Roll back if teleport fails synchronously.
            local previousStamp = RecentHopServers[target.Job]
            RecentHopServers[target.Job] = os.time()
            if not HUD.QueueAutoReExecute() then
                UI.Log("WARN", "Auto reload unavailable in this executor; load V9 manually after hopping", "hop_reload", 10)
            end
            UI.Log("SERVER", "Hopping to " .. target.Job .. " (" .. tostring(target.Region)
                .. ", " .. tostring(target.Count) .. " players)", "hop_target", 1)
            local ok, result = pcall(function() return browser:InvokeServer("teleport", target.Job) end)
            if ok and result ~= false then
                RecentHopServers[target.Job] = os.time()
            else
                RecentHopServers[target.Job] = previousStamp
                UI.HopState.Failed += 1
                UI.Log("WARN", "Teleport failed: " .. tostring(result), "hop_failed", 10)
            end
        end
        task.wait(6)
        if generation == UI.HopState.Generation and HopPhase == "matching" then
            HopPhase = "idle"
            HopCooldownUntil = tick() + 20
            ServerHopCache.List = nil
        end
    end)
end

